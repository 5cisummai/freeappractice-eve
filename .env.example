# Use the same value as the calling app. Supply at least 32 random characters.
COACH_EVE_SERVICE_SECRET=
# Origin of the app that owns tools and student data.
COACH_APP_URL=http://localhost:5173
# Optional. Omitting this key removes web search from Pip's tool list.
PARALLEL_API_KEY=
# Optional automation bypass for a protected app preview.
COACH_APP_VERCEL_BYPASS=
